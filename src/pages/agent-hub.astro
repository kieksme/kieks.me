---
/**
 * Agent-Hub service page
 *
 * TODO ⟦PLATZHALTER: Buchungslink⟧ — CTAs use BOOKING_URL (/kontakt until set in site.ts)
 * TODO ⟦PLATZHALTER: Preisrahmen Agent-Hub, Angabe folgt von André⟧ — visible block shows „Preisrahmen folgt“ until set
 */
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/atoms/Button.astro';
import Sticker from '~/components/ui/atoms/Sticker.astro';
import Heading from '~/components/ui/atoms/Heading.astro';
import Lead from '~/components/ui/atoms/Lead.astro';
import Halftone from '~/components/ui/atoms/Halftone.astro';
import ZigzagDivider from '~/components/ui/atoms/ZigzagDivider.astro';
import Marker from '~/components/ui/atoms/Marker.astro';
import FeatureCard from '~/components/ui/molecules/FeatureCard.astro';
import StepCard from '~/components/ui/molecules/StepCard.astro';
import CtaSection from '~/components/ui/organisms/CtaSection.astro';
import AgentHubFlow from '~/components/ui/AgentHubFlow.astro';
import { BOOKING_URL } from '~/config/site';

const metadata = {
  title: 'Agent-Hub für Unternehmen – Skills, MCP-Server und Agents sicher verteilen',
  description:
    'kieks.me baut Ihren internen Agent-Hub: geprüfte Skills, MCP-Server und Agents an einem Ort, mit Review-Gate, Versionierung und Richtlinien für Claude Code, Codex & Co.',
};

const offers = [
  {
    title: 'Hub-Design',
    description:
      'Struktur, Repository, Versionierung und Verteilweg passend zu Ihren Werkzeugen, etwa Claude Code, Codex oder Google Cloud Agent Registry.',
    edge: 'aqua' as const,
  },
  {
    title: 'Review-Prozess',
    description: 'Prüfkriterien, Rollen und ein Service-Level, damit das Review kein Flaschenhals wird.',
    edge: 'fuchsia' as const,
  },
  {
    title: 'Richtlinien und Durchsetzung',
    description:
      'Allowlists für Marketplaces und MCP-Server, Managed Settings und Verteilung über Ihre bestehenden Werkzeuge.',
    edge: 'aqua' as const,
  },
  {
    title: 'Skills, MCP-Server und Agents entwickeln',
    description: 'Wir bauen die Komponenten, die Ihre Teams wirklich brauchen, und bringen sie geprüft in den Hub.',
    edge: 'fuchsia' as const,
  },
  {
    title: 'Identitäten und Secrets',
    description: 'Sichere Anbindung von MCP-Servern an Ihre Systeme und Zugangsdaten.',
    edge: 'aqua' as const,
  },
  {
    title: 'Betrieb und Monitoring',
    description: 'Nachvollziehen, was wo installiert ist, mit Audit-Trail und Begleitung im laufenden Betrieb.',
    edge: 'fuchsia' as const,
  },
];

const benefits = [
  'Eine Stelle, an der ein fehlerhafter Skill einmal repariert wird – für alle.',
  'Ein Audit-Trail und eine klare Antwort auf die Frage „Was ist wo installiert?“.',
  'Weniger Doppelarbeit zwischen Teams.',
  'Eine Grundlage, um KI-Werkzeuge sicher im ganzen Unternehmen auszurollen.',
];

const steps = [
  {
    num: '01',
    title: 'Bestandsaufnahme',
    description: 'Welche Skills, MCP-Server und Agents nutzen Ihre Teams heute, und woher kommen sie?',
    accent: 'aqua' as const,
    rotate: 1.5,
  },
  {
    num: '02',
    title: 'Konzept',
    description: 'Hub-Struktur, Review-Gate und Richtlinien für Ihre Umgebung.',
    accent: 'fuchsia' as const,
    rotate: -1.5,
  },
  {
    num: '03',
    title: 'Aufbau',
    description: 'Wir richten den Hub ein und überführen die ersten Komponenten.',
    accent: 'yellow' as const,
    rotate: 1.5,
  },
  {
    num: '04',
    title: 'Begleitung',
    description: 'Wir unterstützen beim Betrieb und entwickeln neue Komponenten mit Ihnen.',
    accent: 'purple' as const,
    rotate: -1.5,
  },
];

const flowSteps = [
  {
    title: 'Beitragen',
    description: 'Ihre Teams reichen Skills, MCP-Server und Agents per Pull Request ein.',
  },
  {
    title: 'Prüfen',
    description:
      'Ein Review klärt, was eine Komponente anweist, was sie ausführt und womit sie sich verbindet – für MCP-Server und Agents genauso streng wie für Skills.',
  },
  {
    title: 'Freigeben',
    description: 'Geprüfte Komponenten werden versioniert und gepinnt im internen Marketplace bereitgestellt.',
  },
  {
    title: 'Durchsetzen',
    description:
      'Richtlinien legen fest, dass auf Entwicklerrechnern und in der CI nur Freigegebenes landet. Öffentliche Marketplaces bleiben außen vor.',
  },
];

const flowColors = ['aqua', 'fuchsia', 'yellow', 'purple'] as const;
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden not-prose" style="background: var(--hero-bg);">
    <Halftone
      class="hidden md:block right-0 top-0"
      width={620}
      height={560}
      pitch={20}
      origin="top-right"
      d0={14.78}
      k={0.018}
      color="var(--hero-dots)"
      opacity={0.22}
    />
    <div class="relative mx-auto max-w-[1440px] px-5 md:px-20 pt-16 md:pt-[88px] pb-16 md:pb-20">
      <div class="flex flex-col gap-7 max-w-[900px]">
        <Sticker color="yellow" shadow="fuchsia" rotate={3}>Agent-Hub</Sticker>
        <Heading level={1} size="l" color="var(--hero-heading)" shadowColor="var(--pop-fuchsia)" shadowSize="6px 6px 0">
          ein ort für alle skills, mcp-server und agents ihres unternehmens
        </Heading>
        <Lead size="l" class="!text-[color:var(--hero-text)]">
          Irgendwo in Ihrem Unternehmen gibt es denselben Skill fünfmal: kopiert, leicht verändert, aus dem Internet
          ergänzt. Niemand hat etwas falsch gemacht, es fehlte nur ein Ort, an dem ein Skill leben, besser werden und
          Vertrauen aufbauen kann. Diesen Ort bauen wir mit Ihnen auf.
        </Lead>
        <div class="flex flex-col sm:flex-row gap-5">
          <!-- TODO ⟦PLATZHALTER: Buchungslink⟧ -->
          <Button variant="primary" text="Erstgespräch vereinbaren" href={BOOKING_URL} icon="tabler:calendar-event" />
          <Button
            variant="secondary"
            shadow="aqua"
            text="Zum Fachartikel →"
            href="https://blog.andrelademann.de/de/posts/warum-unternehmen-einen-agent-hub-brauchen/"
            target="_blank"
          />
        </div>
      </div>
    </div>
  </section>

  <ZigzagDivider top="var(--hero-bg)" bottom="var(--surface)" />

  <section class="not-prose py-16 md:py-24" style="background: var(--surface);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 max-w-3xl flex flex-col gap-6">
      <Sticker color="fuchsia" shadow="aqua" rotate={3}>Das Problem</Sticker>
      <Heading level={2} size="l">mehr als ein skill-repository</Heading>
      <Lead>
        Skills, MCP-Server und Agents haben sehr unterschiedliche Risikoprofile. Ein Skill ist überwiegend Markdown mit
        gelegentlichem Skript. Ein MCP-Server ist laufende Software mit Netzwerkzugriff und Zugangsdaten. Ein Agent
        bündelt Anweisungen, Werkzeuge und Berechtigungen. Ein Ordner namens „skills“ wird dem nicht gerecht – ein
        Agent-Hub schon.
      </Lead>
    </div>
  </section>

  <section class="not-prose py-16 md:py-24" style="background: var(--page-bg);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 flex flex-col gap-6">
      <Sticker color="aqua" shadow="fuchsia" rotate={3}>Ablauf</Sticker>
      <Heading level={2} size="l">ein hub, ein review-gate</Heading>
      <ol class="mt-2 grid sm:grid-cols-2 gap-5 list-none p-0 m-0">
        {
          flowSteps.map((s, i) => (
            <li
              class="p-5 bg-[var(--surface)] border-[3px] border-[var(--ink)]"
              style={`box-shadow: 6px 6px 0 0 var(--pop-${flowColors[i % 4]});`}
            >
              <p class="font-heading font-black text-2xl" style="color: var(--pop-fuchsia);">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="font-heading font-extrabold text-lg lowercase mt-1" style="color: var(--text-primary);">
                {s.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary);">
                {s.description}
              </p>
            </li>
          ))
        }
      </ol>
      <div class="mt-6">
        <AgentHubFlow />
      </div>
    </div>
  </section>

  <ZigzagDivider top="var(--page-bg)" bottom="var(--pop-navy)" />

  <section class="not-prose py-16 md:py-24" style="background: var(--pop-navy);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 max-w-3xl flex flex-col gap-6">
      <Sticker color="yellow" shadow="fuchsia" rotate={3}>Sicherheit</Sticker>
      <Heading level={2} size="l" color="#fff" shadowColor="var(--pop-fuchsia)">
        das internet ist keine paketquelle
      </Heading>
      <Lead tone="onColor" class="!text-white/90">
        Ein Skill ist Software: Er kann einen Agenten anweisen, Befehle auszuführen, und eigene Skripte mitbringen. Jede
        ungeprüfte Installation ist ungeprüfte Codeausführung. Koi Security hat Anfang 2026 alle 2.857 Skills im
        öffentlichen Marketplace ClawHub geprüft und 341 bösartige gefunden (
        <a
          href="https://labs.cloudsecurityalliance.org/research/csa-research-note-openclaw-clawhub-supply-chain-risk-2026070/"
          class="font-bold underline underline-offset-4"
          style="color: var(--pop-aqua);"
          target="_blank"
          rel="noopener"
        >
          Quelle: Cloud Security Alliance
        </a>
        ). Scanner helfen, ersetzen aber kein Review. Für Unternehmen mit hohen Sicherheitsanforderungen, etwa im KRITIS-Umfeld,
        ist ein kontrollierter Hub deshalb Pflicht.
      </Lead>
    </div>
  </section>

  <ZigzagDivider top="var(--pop-navy)" bottom="var(--page-bg)" />

  <section class="not-prose py-16 md:py-24" style="background: var(--page-bg);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 flex flex-col gap-6">
      <Sticker color="fuchsia" shadow="aqua" rotate={-2}>Leistungen</Sticker>
      <Heading level={2} size="l">was wir für sie tun</Heading>
      <div class="grid sm:grid-cols-2 gap-7">
        {offers.map((o) => <FeatureCard title={o.title} description={o.description} edge={o.edge} />)}
      </div>
    </div>
  </section>

  <section class="not-prose py-16 md:py-24" style="background: var(--surface); border-top: 4px solid var(--ink);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 max-w-3xl flex flex-col gap-6">
      <Sticker color="aqua" shadow="fuchsia" rotate={3}>Ihr Nutzen</Sticker>
      <Heading level={2} size="l">was sie davon haben</Heading>
      <ul class="mt-2 space-y-4 list-none p-0 m-0">
        {
          benefits.map((b, i) => (
            <li class="flex gap-5 items-start">
              <Marker
                variant="diamond"
                color={(['aqua', 'fuchsia', 'yellow', 'purple'] as const)[i % 4]}
                class="mt-1.5"
              />
              <span class="text-lg" style="color: var(--text-primary);">
                {b}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="not-prose py-16 md:py-24" style="background: var(--page-bg);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 flex flex-col gap-6">
      <Sticker color="yellow" shadow="fuchsia" rotate={3}>Vorgehen</Sticker>
      <Heading level={2} size="l">so starten wir</Heading>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((s) => <StepCard {...s} />)}
      </div>
      {/* TODO ⟦PLATZHALTER: Preisrahmen Agent-Hub, Angabe folgt von André⟧ */}
      <aside
        class="mt-4 max-w-xl p-6 border-[3px] border-[var(--ink)]"
        style="background: var(--pop-yellow); box-shadow: 8px 8px 0 0 var(--pop-fuchsia); color: var(--pop-navy);"
        aria-label="Preisrahmen"
      >
        <p class="font-heading font-extrabold lowercase text-sm tracking-wide">Preisrahmen</p>
        <p class="font-heading font-black lowercase text-2xl md:text-3xl mt-2 leading-tight">Preisrahmen folgt</p>
        <p class="mt-2 text-sm font-semibold opacity-80">
          Konkreter Betrag folgt. Im Erstgespräch klären wir Umfang und Angebot.
        </p>
      </aside>
    </div>
  </section>

  <ZigzagDivider top="var(--page-bg)" bottom="var(--pop-fuchsia)" />

  <!-- TODO ⟦PLATZHALTER: Buchungslink⟧ -->
  <CtaSection
    title="wie heißt diese schicht bei ihnen?"
    text="Skill-Repository, Agent-Hub, Registry oder noch gar nichts? Lassen Sie uns darüber sprechen, wie Ihr Unternehmen Skills, MCP-Server und Agents sicher und gemeinsam nutzt."
    ctaText="Erstgespräch vereinbaren"
  />
</Layout>
