---
import Layout from '~/layouts/PageLayout.astro';
import Logo from '~/components/ui/atoms/Logo.astro';
import HeroArtFinger from '~/components/ui/organisms/HeroArtFinger.astro';
const metadata = { title: 'Brand logo component', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-5 py-12 space-y-8">
    <h1 class="text-3xl font-bold">Original circular brand logo</h1>
    <p>
      The approved navy disc stays on light surfaces. On dark surfaces the disc stays open so the background pattern
      shows through, and an aqua ring keeps the circle visible. Animation changes opacity only and respects reduced
      motion.
    </p>
    <div class="flex gap-8 items-end">
      <Logo size="sm" isAnimated={false} />
      <Logo size="md" />
      <div class="p-4" style="background: var(--pop-navy);">
        <Logo variant="dark" size="md" isAnimated={false} />
      </div>
    </div>
    <div class="max-w-sm"><HeroArtFinger showOpenSource={false} /></div>
    <p>
      Props: variant (auto/light/dark), size (sm/md/hero), layout (mark/horizontal), isAnimated (default true), class.
    </p>
    <div class="flex flex-col gap-4 bg-[var(--surface)] p-4">
      <Logo layout="horizontal" size="md" isAnimated={false} />
    </div>
  </section>
</Layout>
