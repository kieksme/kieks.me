---
import PageLayout from '~/layouts/PageLayout.astro';
import AuthorContact from '~/components/blog/AuthorContact.astro';
import StructuredData from '~/components/common/StructuredData.astro';
---

<PageLayout metadata={{ title: 'CMS-Komponenten', robots: { index: false, follow: false } }}>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1>CMS-Komponenten</h1>
    <p>AuthorContact bekommt authorSlug, authorName und optional isDemo. Die Demo sendet keine Anfragen.</p>
    <AuthorContact authorSlug="demo-author" authorName="Demo-Autorin" isDemo />
    <p>StructuredData erhält items als Array öffentlicher Schema.org-Objekte und schreibt sicheres JSON-LD.</p>
    <StructuredData items={[{ '@type': 'CreativeWork', name: 'Dokumentationsbeispiel' }]} />
  </section>
</PageLayout>
