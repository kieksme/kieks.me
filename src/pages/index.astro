---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import Placeholder from '~/components/common/Placeholder.astro';
import SectionCTA from '~/components/widgets/SectionCTA.astro';
import KantenDivider from '~/components/ui/KantenDivider.astro';
import EdgeAvatar from '~/components/ui/EdgeAvatar.astro';
import PopHand from '~/components/ui/PopHand.astro';
import { BOOKING_URL, GITHUB_ORG_URL } from '~/config/site';
import avatarAndre from '~/assets/brand/avatars/kieksme-avatar-alademann.png';
import avatarThomas from '~/assets/brand/avatars/kieksme-avatar-tschoene.png';

const metadata = {
  title: 'kieks.me – AI Consultants für Skills, MCP und Agent-Hubs | Leipzig',
  description:
    'kieks.me GbR aus Leipzig: AI Consultants für Skills, MCP-Server, Agents und Agent-Hubs – plus Cloud, DevOps, Webentwicklung und Beratung.',
  ignoreTitleTemplate: true,
};

const services = [
  {
    num: '01',
    title: 'Agent-Hub',
    description:
      'Ein zentraler, geprüfter Ort für alle Skills, MCP-Server und Agents in Ihrem Unternehmen. Mit Review-Prozess, Versionierung und klaren Regeln, was auf Entwicklerrechner gelangt.',
    href: '/agent-hub',
    linkText: 'Mehr zum Agent-Hub',
    tone: 'aqua',
  },
  {
    num: '02',
    title: 'KI & MCP',
    description:
      'Skills, MCP-Server und Agents: Wir binden KI-Assistenten an Ihre Systeme und Daten an, nachvollziehbar und mit klaren Zugriffsrechten.',
    href: '/leistungen/ki-mcp',
    linkText: 'Mehr zu KI & MCP',
    tone: 'fuchsia',
  },
  {
    num: '03',
    title: 'Cloud & DevOps',
    description: 'Infrastruktur als Code, automatisierte Builds und Deployments, verlässlicher Betrieb.',
    href: '/leistungen/cloud-devops',
    linkText: 'Mehr zu Cloud & DevOps',
    tone: 'purple',
  },
  {
    num: '04',
    title: 'Web- & Softwareentwicklung',
    description: 'Websites, Webanwendungen und Schnittstellen, neu entwickelt oder gezielt weiterentwickelt.',
    href: '/leistungen/entwicklung',
    linkText: 'Mehr zur Entwicklung',
    tone: 'yellow',
  },
  {
    num: '05',
    title: 'Beratung & Workshops',
    description: 'Gemeinsam klären, was sich lohnt, bevor die erste Zeile Code entsteht.',
    href: '/leistungen/beratung',
    linkText: 'Mehr zu Beratung',
    tone: 'aqua',
  },
] as const;

const projects = [
  { name: 'mcp-server – contabo', href: 'https://github.com/kieksme', tone: 'aqua' },
  { name: 'mcp-server – swetrix', href: 'https://github.com/kieksme', tone: 'fuchsia' },
  { name: 'mcp-server – listmonk', href: 'https://github.com/kieksme', tone: 'yellow' },
  { name: 'mcp-server – balena', href: 'https://github.com/kieksme', tone: 'purple' },
] as const;

const faqs = [
  {
    title: 'Warum kieks.me und nicht eine andere Agentur?',
    description:
      'Bei uns arbeiten Sie direkt mit den Gesellschaftern, ohne Zwischenstationen. Offenheit, Ehrlichkeit und Transparenz sind für uns keine Schlagworte: Wir sagen Ihnen auch, wenn sich etwas nicht lohnt. Und Sie erhalten am Ende Code und Dokumentation, mit denen Ihr Team oder ein anderer Dienstleister weiterarbeiten kann.',
    mark: 'yellow',
  },
  {
    title: 'Für welche Unternehmen arbeiten Sie?',
    description:
      'Vor allem für mittelständische Unternehmen und IT-Dienstleister, die ihre Software, ihre Systemlandschaft oder ihren Support pragmatisch verbessern möchten. ⟦BESTÄTIGEN: Zielgruppe⟧',
    mark: 'aqua',
  },
  {
    title: 'Was brauchen Sie von uns für den Start?',
    description:
      'Ein Ziel, eine Ansprechperson und Zugang zu den Informationen, um die es geht: Systeme, Abläufe, Zielgruppe. Den Rest klären wir im Erstgespräch.',
    mark: 'fuchsia',
  },
  {
    title: 'Wie lange dauert ein Projekt?',
    description:
      'Das hängt vom Umfang ab. Eine Website setzen wir in der Regel in 4 bis 8 Wochen um ⟦BESTÄTIGEN: bisherige Angabe⟧. Für größere Vorhaben nennen wir Ihnen nach dem Erstgespräch einen realistischen Zeitrahmen.',
    mark: 'yellow',
  },
  {
    title: 'Was kostet das?',
    description:
      'Auch das hängt vom Umfang ab. Sie erhalten ein schriftliches Angebot, bevor Kosten entstehen. Eine Website kostet in der Regel zwischen 1.000 und 10.000 Euro ⟦BESTÄTIGEN: bisherige Angabe, noch aktuell?⟧. Alle Preise verstehen sich netto zuzüglich der gesetzlichen Umsatzsteuer.',
    mark: 'aqua',
  },
  {
    title: 'Wer pflegt die Lösung danach?',
    description:
      'Ganz wie Sie möchten. Sie können selbst weitermachen, wir schulen Ihr Team dafür. Oder wir übernehmen die Pflege im Rahmen eines Wartungsvertrags ⟦BESTÄTIGEN: Wartungsangebot existiert⟧.',
    mark: 'fuchsia',
  },
  {
    title: 'Was passiert, wenn Sie nicht zufrieden sind?',
    description:
      'Dann sprechen wir offen darüber und bessern im vereinbarten Umfang nach. Damit es gar nicht so weit kommt, stimmen wir Zwischenstände regelmäßig mit Ihnen ab. ⟦BESTÄTIGEN: Einschränkung gegenüber unbegrenztem Nachbesserungsversprechen⟧',
    mark: 'yellow',
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero — Pop-Art aqua (light) / navy (dark) -->
  <section class="relative overflow-hidden not-prose md:-mt-[76px]" style="background: var(--pop-hero-bg);">
    <div class="absolute inset-0 pop-halftone" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-24 md:pt-32 pb-16 md:pb-20">
      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 items-center">
        <div class="max-w-3xl">
          <span class="pop-badge motion-safe:animate-fade-in">kieks.me GbR · Leipzig</span>
          <h1
            class="pop-display pop-display--offset text-4xl sm:text-5xl md:text-6xl mt-6 motion-safe:animate-slide-up"
            style="color: var(--pop-hero-heading);"
          >
            Ihre Software. Ihr Code. Unsere Erfahrung.
          </h1>
          <p
            class="mt-6 text-lg md:text-xl max-w-[40rem] motion-safe:animate-fade"
            style="color: var(--pop-hero-text);"
          >
            Wir sind AI Consultants aus Leipzig. Wir entwickeln Skills, MCP-Server und Agents für Ihr Unternehmen und
            bauen den Agent-Hub, über den Ihre Teams sie sicher nutzen.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4 motion-safe:animate-fade">
            <Button variant="primary" text="Erstgespräch buchen" href={BOOKING_URL} icon="tabler:calendar-event" />
            <Button variant="secondary" text="Leistungen ansehen" href="#leistungen" />
          </div>
          <Placeholder label="⟦BESTÄTIGEN⟧" class="mt-8 max-w-xl">
            Claim „Ihre Software. Ihr Code. Unsere Erfahrung.“ als Unternehmens-Claim freigeben (D2).
          </Placeholder>
        </div>

        <div class="relative justify-self-center lg:justify-self-end w-full max-w-sm" aria-hidden="true">
          <div class="relative mx-auto flex h-64 w-64 items-center justify-center sm:h-72 sm:w-72">
            <div
              class="absolute inset-0"
              style="background: var(--pop-yellow); clip-path: polygon(50% 0%, 61% 18%, 80% 8%, 78% 28%, 100% 35%, 82% 48%, 95% 68%, 72% 68%, 70% 90%, 50% 78%, 30% 90%, 28% 68%, 5% 68%, 18% 48%, 0% 35%, 22% 28%, 20% 8%, 39% 18%); border: 0; outline: 3px solid var(--pop-navy); outline-offset: -3px;"
            >
            </div>
            <PopHand size={168} class="relative z-10" />
            <span
              class="absolute bottom-6 left-1/2 z-20 -translate-x-1/2 whitespace-nowrap px-3 py-1 font-heading text-sm font-black lowercase"
              style="background: var(--pop-fuchsia); color: #fff; border: 2.5px solid var(--pop-navy); box-shadow: 4px 4px 0 0 var(--pop-navy);"
            >
              open source!
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Haltung band -->
    <div class="relative" style="background: var(--pop-band-bg); color: var(--pop-band-text);">
      <KantenDivider from="navy" class="dark:hidden relative -mt-px" />
      <div class="hidden dark:block">
        <KantenDivider from="aqua" class="relative -mt-px" />
      </div>
      <div class="max-w-6xl px-4 py-5 mx-auto text-center sm:px-6">
        <p class="font-heading font-extrabold text-base md:text-lg lowercase tracking-tight">
          <span class="pop-badge pop-badge--fuchsia mr-2 align-middle">unsere Haltung</span>
          einfach statt kompliziert · bewährt statt modisch · offen statt abhängig.
        </p>
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section id="leistungen" class="not-prose py-14 md:py-20" style="background: var(--pop-page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="pop-badge pop-badge--aqua">Leistungen</span>
      <h2 class="pop-display text-3xl md:text-5xl mt-4">Was wir für Sie tun</h2>
      <p class="mt-4 text-lg max-w-3xl" style="color: var(--pop-text-secondary);">
        Fünf Schwerpunkte, ein Anspruch: Lösungen, die zu Ihrem Unternehmen passen und die Ihr Team versteht.
      </p>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          services.map((s) => (
            <article class:list={['pop-service-card', `pop-service-card--${s.tone}`]}>
              <div class="pop-service-card__head">
                <span class="pop-service-card__num">{s.num}</span>
              </div>
              <div class="pop-service-card__body">
                <h3 class="pop-service-card__title">{s.title}</h3>
                <p class="text-sm leading-relaxed" style="color: var(--pop-text-secondary);">
                  {s.description}
                </p>
                <a class="pop-service-card__link" href={s.href}>
                  {s.linkText} →
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <Placeholder label="⟦ENTSCHEIDUNG D6⟧" class="mt-8 max-w-2xl">
        Social Media und SEO waren bisher eigene Leistungen. Hier bewusst nicht als Kachel. Weglassen oder als Teil von
        „Web- & Softwareentwicklung“ nennen?
      </Placeholder>
    </div>
  </section>

  <!-- Open Source -->
  <section class="not-prose py-14 md:py-16" style="background: var(--pop-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-10 items-start">
        <div>
          <span class="pop-badge">nur echtes Zeug</span>
          <h2 class="pop-display text-3xl md:text-4xl mt-4" style="color: var(--pop-purple);">
            Open Source, öffentlich nachprüfbar
          </h2>
          <p class="mt-4 text-lg" style="color: var(--pop-text-secondary);">
            Wir veröffentlichen eigene MCP-Server, zum Beispiel für Contabo, Swetrix, Listmonk und Balena, sowie
            Agent-Skills und Werkzeuge auf GitHub. So sehen Sie vor dem ersten Gespräch, wie wir arbeiten.
          </p>
          <div class="mt-6 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
            <Button variant="primary" text="Unsere MCP-Server ansehen" href="/projekte/mcp-server" />
            <a
              href={GITHUB_ORG_URL}
              class="font-heading font-bold underline-offset-4 hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              Alle Projekte auf GitHub →
            </a>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          {
            projects.map((p) => (
              <a
                class:list={['pop-project-row', `pop-project-row--${p.tone}`]}
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{p.name}</span>
                <span class="text-sm font-bold opacity-70">GitHub</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CSP -->
  <section
    class="not-prose relative overflow-hidden pop-zigzag-both py-16 md:py-20"
    style="background: var(--pop-purple);"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative">
      <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
        <div>
          <span class="pop-badge pop-badge--aqua">unser Produkt</span>
          <h2 class="pop-display text-3xl md:text-4xl mt-4 text-white">
            CSP: ein eigenes Serviceportal für IT-Dienstleister
          </h2>
          <p class="mt-4 text-lg text-white/90 max-w-2xl">
            Das Customer Service Portal bündelt Status, Bereitschaft, Ansprechpartner und Supportwissen vor Ihrem
            vorhandenen Ticketsystem. Open Source unter MIT, mit direktem Weg zum Menschen.
          </p>
          <div class="mt-6">
            <Button variant="primary" text="CSP kennenlernen" href="/csp" />
          </div>
          <Placeholder label="⟦PLATZHALTER / D4⟧" class="mt-6 max-w-2xl">
            Ziel-URL: kieks.me/csp oder csp.kieks.me — siehe Entscheidung D4.
          </Placeholder>
        </div>
        <div class="justify-self-center">
          <div class="pop-starburst pop-starburst--lime">
            <span class="pop-starburst__label">open source<br />MIT-Lizenz</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="not-prose py-14 md:py-20" style="background: var(--pop-page-bg);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <span class="pop-badge pop-badge--fuchsia">Team</span>
      <h2 class="pop-display text-3xl md:text-5xl mt-4">Wer dahintersteht</h2>
      <p class="mt-4 text-lg max-w-3xl" style="color: var(--pop-text-secondary);">
        kieks.me ist die GbR von André Lademann und Thomas Schöne in Leipzig – AI Consultants für Skills, MCP-Server,
        Agents und Agent-Hubs. Sie sprechen bei uns direkt mit den Menschen, die Ihr Projekt umsetzen.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-10 sm:gap-16 items-start">
        <EdgeAvatar
          name="André Lademann"
          label="andré"
          image={avatarAndre}
          imageAlt="André Lademann, Gesellschafter der kieks.me GbR"
          role="⟦PLATZHALTER D10: Rolle und 1–2 Sätze, selbst formuliert⟧"
        />
        <EdgeAvatar
          name="Thomas Schöne"
          label="thomas"
          image={avatarThomas}
          imageAlt="Thomas Schöne, Gesellschafter der kieks.me GbR"
          role="⟦PLATZHALTER D10: Rolle und 1–2 Sätze, selbst formuliert⟧"
          variant="fuchsia"
        />
      </div>
      <Placeholder label="⟦PLATZHALTER D10⟧" class="mt-8 max-w-2xl">
        Rollen und Kurztexte fehlen in der Copy-Datei — hier bewusst nicht erfunden. Fotos aus
        kieks.me.brand/source/avatars/ (kieksme-avatar-alademann.png, kieksme-avatar-tschoene.png).
      </Placeholder>
    </div>
  </section>

  <!-- FAQ -->
  <section class="not-prose py-14 md:py-16" style="background: var(--pop-surface);">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <span class="pop-badge">FAQ</span>
      <h2 class="pop-display text-3xl md:text-4xl mt-4">Häufige Fragen</h2>
      <p class="mt-3 text-lg" style="color: var(--pop-text-secondary);">Kurz und ehrlich beantwortet.</p>

      <div class="mt-10 grid md:grid-cols-2 gap-x-10 gap-y-8">
        {
          faqs.map((f) => (
            <article class="flex gap-3" style="border-bottom: 1px solid rgb(30 42 69 / 15%); padding-bottom: 1.25rem;">
              <span
                class:list={[
                  'pop-faq-mark',
                  f.mark === 'aqua' && 'pop-faq-mark--aqua',
                  f.mark === 'fuchsia' && 'pop-faq-mark--fuchsia',
                ]}
              />
              <div>
                <h3 class="font-heading font-extrabold text-lg leading-snug" style="color: var(--pop-text-primary);">
                  {f.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed" style="color: var(--pop-text-secondary);">
                  {f.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <SectionCTA
    title="Lernen wir uns kennen"
    text="Qualität, Tempo und Verlässlichkeit sind wichtig. Am wichtigsten ist aber, dass wir uns gegenseitig respektieren und vertrauen können. Finden wir in 30 Minuten heraus, ob wir zusammenpassen."
    showEmailLink={true}
  />
</Layout>
