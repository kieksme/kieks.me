---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/atoms/Button.astro';
import Sticker from '~/components/ui/atoms/Sticker.astro';
import Heading from '~/components/ui/atoms/Heading.astro';
import Lead from '~/components/ui/atoms/Lead.astro';
import TextLink from '~/components/ui/atoms/TextLink.astro';
import Halftone from '~/components/ui/atoms/Halftone.astro';
import ZigzagDivider from '~/components/ui/atoms/ZigzagDivider.astro';
import Note from '~/components/ui/atoms/Note.astro';
import ServiceCard from '~/components/ui/molecules/ServiceCard.astro';
import RepoRow from '~/components/ui/molecules/RepoRow.astro';
import FaqItem from '~/components/ui/molecules/FaqItem.astro';
import AvatarCard from '~/components/ui/molecules/AvatarCard.astro';
import MarqueeBand from '~/components/ui/organisms/MarqueeBand.astro';
import HeroArtFinger from '~/components/ui/organisms/HeroArtFinger.astro';
import CtaSection from '~/components/ui/organisms/CtaSection.astro';
import { BOOKING_URL, GITHUB_ORG_URL } from '~/config/site';
import avatarAndre from '~/assets/brand/avatars/kieksme-avatar-alademann.png';
import avatarThomas from '~/assets/brand/avatars/kieksme-avatar-tschoene.png';
import cspBurst from '~/assets/pop/654-1669_csp-art__imgBurst.svg?url';

const metadata = {
  title: 'kieks.me – AI Consultants für Skills, MCP und Agent-Hubs | Leipzig',
  description:
    'kieks.me GbR aus Leipzig: AI Consultants für Skills, MCP-Server, Agents und Agent-Hubs – plus Cloud, DevOps, Webentwicklung und Beratung.',
  ignoreTitleTemplate: true,
};

const services = [
  {
    num: '01',
    title: 'Agent-Hub',
    description:
      'Ein zentraler, geprüfter Ort für alle Skills, MCP-Server und Agents in Ihrem Unternehmen. Mit Review-Prozess, Versionierung und klaren Regeln, was auf Entwicklerrechner gelangt.',
    href: '/agent-hub',
    linkText: 'Mehr zum Agent-Hub',
    headColor: 'aqua' as const,
    shadow: 'ink' as const,
    numShadow: 'fuchsia' as const,
  },
  {
    num: '02',
    title: 'KI & MCP',
    description:
      'Skills, MCP-Server und Agents: Wir binden KI-Assistenten an Ihre Systeme und Daten an, nachvollziehbar und mit klaren Zugriffsrechten.',
    href: '/leistungen/ki-mcp',
    linkText: 'Mehr zu KI & MCP',
    headColor: 'fuchsia' as const,
    shadow: 'ink' as const,
    numShadow: 'aqua' as const,
  },
  {
    num: '03',
    title: 'Cloud & DevOps',
    description: 'Infrastruktur als Code, automatisierte Builds und Deployments, verlässlicher Betrieb.',
    href: '/leistungen/cloud-devops',
    linkText: 'Mehr zu Cloud & DevOps',
    headColor: 'purple' as const,
    shadow: 'ink' as const,
    numShadow: 'fuchsia' as const,
    numColor: '#fff',
  },
  {
    num: '04',
    title: 'Web- & Softwareentwicklung',
    description: 'Websites, Webanwendungen und Schnittstellen, neu entwickelt oder gezielt weiterentwickelt.',
    href: '/leistungen/entwicklung',
    linkText: 'Mehr zur Entwicklung',
    headColor: 'yellow' as const,
    shadow: 'fuchsia' as const,
    numShadow: 'fuchsia' as const,
  },
  {
    num: '05',
    title: 'Beratung & Workshops',
    description: 'Gemeinsam klären, was sich lohnt, bevor die erste Zeile Code entsteht.',
    href: '/leistungen/beratung',
    linkText: 'Mehr zu Beratung',
    headColor: 'aqua' as const,
    shadow: 'ink' as const,
    numShadow: 'fuchsia' as const,
  },
];

const projects = [
  { name: 'mcp-server · contabo', href: 'https://github.com/kieksme', color: 'aqua' as const },
  { name: 'mcp-server · swetrix', href: 'https://github.com/kieksme', color: 'fuchsia' as const },
  { name: 'mcp-server · listmonk', href: 'https://github.com/kieksme', color: 'yellow' as const },
  { name: 'mcp-server · balena', href: 'https://github.com/kieksme', color: 'purple' as const },
];

const faqsLeft = [
  {
    title: 'Warum kieks.me und nicht eine andere Agentur?',
    body: 'Bei uns arbeiten Sie direkt mit den Gesellschaftern, ohne Zwischenstationen. Offenheit, Ehrlichkeit und Transparenz sind für uns keine Schlagworte: Wir sagen Ihnen auch, wenn sich etwas nicht lohnt. Und Sie erhalten am Ende Code und Dokumentation, mit denen Ihr Team oder ein anderer Dienstleister weiterarbeiten kann.',
    color: 'aqua' as const,
  },
  {
    title: 'Für welche Unternehmen arbeiten Sie?',
    body: 'Vor allem für mittelständische Unternehmen und IT-Dienstleister, die ihre Software, ihre Systemlandschaft oder ihren Support pragmatisch verbessern möchten. ⟦BESTÄTIGEN: Zielgruppe⟧',
    color: 'fuchsia' as const,
  },
  {
    title: 'Was brauchen Sie von uns für den Start?',
    body: 'Ein Ziel, eine Ansprechperson und Zugang zu den Informationen, um die es geht: Systeme, Abläufe, Zielgruppe. Den Rest klären wir im Erstgespräch.',
    color: 'yellow' as const,
  },
  {
    title: 'Wie lange dauert ein Projekt?',
    body: 'Das hängt vom Umfang ab. Eine Website setzen wir in der Regel in 4 bis 8 Wochen um ⟦BESTÄTIGEN: bisherige Angabe⟧. Für größere Vorhaben nennen wir Ihnen nach dem Erstgespräch einen realistischen Zeitrahmen.',
    color: 'purple' as const,
  },
];

const faqsRight = [
  {
    title: 'Was kostet das?',
    body: 'Auch das hängt vom Umfang ab. Sie erhalten ein schriftliches Angebot, bevor Kosten entstehen. Eine Website kostet in der Regel zwischen 1.000 und 10.000 Euro ⟦BESTÄTIGEN: bisherige Angabe, noch aktuell?⟧. Alle Preise verstehen sich netto zuzüglich der gesetzlichen Umsatzsteuer.',
    color: 'aqua' as const,
  },
  {
    title: 'Wer pflegt die Lösung danach?',
    body: 'Ganz wie Sie möchten. Sie können selbst weitermachen, wir schulen Ihr Team dafür. Oder wir übernehmen die Pflege im Rahmen eines Wartungsvertrags ⟦BESTÄTIGEN: Wartungsangebot existiert⟧.',
    color: 'fuchsia' as const,
  },
  {
    title: 'Was passiert, wenn Sie nicht zufrieden sind?',
    body: 'Dann sprechen wir offen darüber und bessern im vereinbarten Umfang nach. Damit es gar nicht so weit kommt, stimmen wir Zwischenstände regelmäßig mit Ihnen ab. ⟦BESTÄTIGEN: Einschränkung gegenüber unbegrenztem Nachbesserungsversprechen⟧',
    color: 'yellow' as const,
  },
];
---

<Layout metadata={metadata}>
  <!-- 3.2 Hero -->
  <section class="relative overflow-hidden not-prose" style="background: var(--hero-bg);">
    <Halftone
      class="hidden md:block right-0 top-0"
      width={620}
      height={560}
      pitch={20}
      origin="top-right"
      d0={14.78}
      k={0.018}
      color="var(--hero-dots)"
      opacity={0.22}
    />
    <div class="relative mx-auto max-w-[1440px] px-5 md:px-20 pt-16 md:pt-[88px] pb-16 md:pb-20">
      <div class="grid lg:grid-cols-[760fr_520fr] gap-10 items-start">
        <div class="flex flex-col gap-7 max-w-[760px]">
          <Sticker color="yellow" shadow="fuchsia" rotate={3}>kieks.me GbR · Leipzig</Sticker>
          <Heading
            level={1}
            size="xl"
            color="var(--hero-heading)"
            shadowColor="var(--pop-fuchsia)"
            shadowSize="6px 6px 0"
          >
            ihre software.<br />ihr code.<br />unsere erfahrung.
          </Heading>
          <Lead size="l" tone="onColor" class="!text-[color:var(--hero-text)]">
            Wir sind AI Consultants aus Leipzig. Wir entwickeln Skills, MCP-Server und Agents für Ihr Unternehmen und
            bauen den Agent-Hub, über den Ihre Teams sie sicher nutzen.
          </Lead>
          <div class="flex flex-col sm:flex-row gap-5">
            <Button variant="primary" shadow="fuchsia" href={BOOKING_URL} text="Erstgespräch buchen" />
            <Button variant="secondary" shadow="aqua" href="#leistungen" text="Leistungen ansehen" />
          </div>
          <Note label="⟦BESTÄTIGEN⟧" class="max-w-[520px]">
            Claim „Ihre Software. Ihr Code. Unsere Erfahrung.“ als Unternehmens-Claim freigeben (D2).
          </Note>
        </div>
        <HeroArtFinger class="lg:mt-10" />
      </div>
    </div>
  </section>

  <ZigzagDivider top="var(--hero-bg)" bottom="var(--band-bg)" />
  <MarqueeBand />
  <ZigzagDivider top="var(--band-bg)" bottom="var(--page-bg)" />

  <!-- 3.5 Leistungen -->
  <section id="leistungen" class="not-prose py-16 md:py-24" style="background: var(--page-bg);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20">
      <Sticker color="aqua" shadow="fuchsia" rotate={3}>Leistungen</Sticker>
      <Heading level={2} size="l" class="mt-6">was wir für sie tun</Heading>
      <Lead class="mt-6 max-w-[760px]">
        Fünf Schwerpunkte, ein Anspruch: Lösungen, die zu Ihrem Unternehmen passen und die Ihr Team versteht.
      </Lead>
      <div class="mt-6 grid sm:grid-cols-2 xl:grid-cols-3 gap-7">
        {services.map((s) => <ServiceCard {...s} />)}
      </div>
      <Note label="⟦ENTSCHEIDUNG D6⟧" class="mt-6 max-w-[640px]">
        Social Media und SEO waren bisher eigene Leistungen. Hier bewusst nicht als Kachel. Weglassen oder als Teil von
        „Web- & Softwareentwicklung“ nennen?
      </Note>
    </div>
  </section>

  <!-- 3.6 Open Source -->
  <section
    class="not-prose py-16 md:py-24"
    style="background: var(--surface); border-top: 4px solid var(--ink); border-bottom: 4px solid var(--ink);"
  >
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="flex flex-col gap-6">
        <Sticker color="yellow" shadow="aqua" rotate={-2}>Aus unserer Werkstatt</Sticker>
        <Heading level={2} size="l">open source, öffentlich nachprüfbar</Heading>
        <Lead>
          Wir veröffentlichen eigene MCP-Server, zum Beispiel für Contabo, Swetrix, Listmonk und Balena, sowie
          Agent-Skills und Werkzeuge auf GitHub. So sehen Sie vor dem ersten Gespräch, wie wir arbeiten.
        </Lead>
        <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
          <Button variant="aqua" shadow="fuchsia" href="/projekte/mcp-server" text="Unsere MCP-Server ansehen" />
          <TextLink href={GITHUB_ORG_URL} target="_blank">Alle Projekte auf GitHub</TextLink>
        </div>
      </div>
      <div class="flex flex-col gap-[18px]">
        {projects.map((p) => <RepoRow {...p} />)}
      </div>
    </div>
  </section>

  <ZigzagDivider top="var(--surface)" bottom="var(--pop-purple-deep)" />

  <!-- 3.7 CSP -->
  <section class="relative overflow-hidden not-prose py-16 md:py-24" style="background: var(--pop-purple-deep);">
    <Halftone
      class="hidden md:block right-0 top-0"
      width={700}
      height={560}
      pitch={22}
      origin="top-right"
      d0={15.8}
      k={0.0178}
      color="#ff008f"
      opacity={0.55}
    />
    <div class="relative mx-auto max-w-[1440px] px-5 md:px-20 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
      <div class="flex flex-col gap-6 max-w-[720px]">
        <Sticker color="aqua" shadow="fuchsia" rotate={3}>Unser Produkt</Sticker>
        <Heading level={2} size="l" color="#fff" shadowColor="var(--pop-navy)">
          csp: ein eigenes<br />serviceportal für<br />it-dienstleister
        </Heading>
        <Lead tone="onColor" class="!text-white">
          Das Customer Service Portal bündelt Status, Bereitschaft, Ansprechpartner und Supportwissen vor Ihrem
          vorhandenen Ticketsystem. Open Source unter MIT, mit direktem Weg zum Menschen.
        </Lead>
        <Button variant="primary" href="/csp" text="CSP kennenlernen" />
        <Note label="⟦PLATZHALTER / D4⟧" class="max-w-xl">
          Ziel-URL: kieks.me/csp oder csp.kieks.me — siehe Entscheidung D4.
        </Note>
      </div>
      <div class="relative justify-self-center w-full max-w-[400px]">
        <img
          src={cspBurst}
          alt=""
          class="motion-safe:pop-spin-slow w-full h-auto"
          width="400"
          height="400"
          decoding="async"
        />
        <div
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center font-heading font-black lowercase leading-none"
          style="transform: translate(-50%, -50%) rotate(6deg); color: var(--pop-navy);"
        >
          <p class="text-[clamp(1.75rem,4vw,2.75rem)]">open source</p>
          <p class="text-[clamp(1.25rem,3vw,1.875rem)] mt-1">MIT-Lizenz</p>
        </div>
      </div>
    </div>
  </section>

  <ZigzagDivider top="var(--pop-purple-deep)" bottom="var(--page-bg)" />

  <!-- 3.8 Team -->
  <section class="not-prose py-16 md:py-24" style="background: var(--page-bg);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 grid lg:grid-cols-[1fr_auto] gap-12 items-center">
      <div class="flex flex-col gap-6 max-w-md">
        <Sticker color="fuchsia" shadow="aqua" rotate={3}>Team</Sticker>
        <Heading level={2} size="l">wer<br />dahintersteht</Heading>
        <Lead>
          kieks.me ist die GbR von André Lademann und Thomas Schöne in Leipzig – AI Consultants für Skills, MCP-Server,
          Agents und Agent-Hubs. Sie sprechen bei uns direkt mit den Menschen, die Ihr Projekt umsetzen.
        </Lead>
        <Note label="⟦PLATZHALTER D10⟧">
          Rollen und Kurztexte fehlen in der Copy-Datei — hier bewusst nicht erfunden.
        </Note>
      </div>
      <div class="flex flex-col sm:flex-row gap-10">
        <AvatarCard
          name="André Lademann"
          label="andré"
          image={avatarAndre}
          imageAlt="André Lademann, Gesellschafter der kieks.me GbR"
          role="⟦PLATZHALTER D10: Rolle und 1–2 Sätze, selbst formuliert⟧"
        />
        <AvatarCard
          name="Thomas Schöne"
          label="thomas"
          image={avatarThomas}
          imageAlt="Thomas Schöne, Gesellschafter der kieks.me GbR"
          role="⟦PLATZHALTER D10: Rolle und 1–2 Sätze, selbst formuliert⟧"
        />
      </div>
    </div>
  </section>

  <!-- 3.9 FAQ -->
  <section class="not-prose py-16 md:py-24" style="background: var(--surface); border-top: 4px solid var(--ink);">
    <div class="mx-auto max-w-[1440px] px-5 md:px-20 flex flex-col gap-6">
      <Sticker color="yellow" shadow="fuchsia" rotate={3}>FAQ</Sticker>
      <Heading level={2} size="l">häufige fragen</Heading>
      <Lead>Kurz und ehrlich beantwortet.</Lead>
      <div class="grid md:grid-cols-2 gap-x-16">
        <div>
          {
            faqsLeft.map((f) => (
              <FaqItem title={f.title} color={f.color}>
                {f.body}
              </FaqItem>
            ))
          }
        </div>
        <div>
          {
            faqsRight.map((f) => (
              <FaqItem title={f.title} color={f.color}>
                {f.body}
              </FaqItem>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <ZigzagDivider top="var(--surface)" bottom="var(--pop-fuchsia)" />

  <CtaSection
    title="lernen wir uns kennen"
    text="Qualität, Tempo und Verlässlichkeit sind wichtig. Am wichtigsten ist aber, dass wir uns gegenseitig respektieren und vertrauen können. Finden wir in 30 Minuten heraus, ob wir zusammenpassen."
    showEmailLink={true}
  />
</Layout>
