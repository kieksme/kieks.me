---
import Layout from '~/layouts/PageLayout.astro';
import Placeholder from '~/components/common/Placeholder.astro';
import { BOOKING_URL, CONTACT_RESPONSE_DAYS, HAS_BOOKING_URL } from '~/config/site';

const metadata = {
  title: 'Kontakt',
  description: 'Schreiben Sie kieks.me GbR oder buchen Sie ein Erstgespräch. Wir melden uns bei Ihnen.',
};
---

<Layout metadata={metadata}>
  <div class="relative px-6 py-16 isolate sm:py-24 lg:px-8 not-prose">
    <div class="kanten-hero-bg opacity-40" aria-hidden="true">
      <span class="kanten-hero-bg__block kanten-hero-bg__block--aqua"></span>
      <span class="kanten-hero-bg__block kanten-hero-bg__block--fuchsia"></span>
    </div>
    <div class="relative max-w-2xl mx-auto text-center">
      <span class="pop-badge">Kontakt</span>
      <h1 class="pop-display text-4xl sm:text-5xl mt-4 text-balance">Kontakt</h1>
      <p class="mt-4 text-lg" style="color: var(--pop-text-secondary);">
        Schreiben Sie uns, wir melden uns innerhalb von {CONTACT_RESPONSE_DAYS} Werktagen. Oder buchen Sie direkt ein Erstgespräch.
      </p>
      {
        HAS_BOOKING_URL ? (
          <p class="mt-4">
            <a href={BOOKING_URL} class="font-semibold underline-offset-4 hover:underline">
              Erstgespräch buchen →
            </a>
          </p>
        ) : (
          <Placeholder label="⟦PLATZHALTER D1⟧" class="mt-4 text-left">
            Buchungslink noch nicht gesetzt — CTAs führen auf diese Kontaktseite (src/config/site.ts → BOOKING_URL).
          </Placeholder>
        )
      }
    </div>
    <form
      name="contact"
      action="/kontakt-erfolgreich"
      data-netlify="true"
      netlify-honeypot="bot-field"
      method="POST"
      class="relative max-w-xl mx-auto mt-12 sm:mt-16 kanten-card p-6 sm:p-8"
    >
      <p class="hidden">
        <label>Nicht ausfüllen: <input name="bot-field" /></label>
      </p>
      <input type="hidden" name="form-name" value="contact" />
      <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
        <div>
          <label for="first-name" class="block font-semibold text-navy dark:text-slate-200 text-sm">Vorname</label>
          <div class="mt-2.5">
            <input
              type="text"
              name="first-name"
              id="first-name"
              autocomplete="given-name"
              required
              class="block w-full border border-navy-100 bg-white dark:bg-navy-400 dark:border-navy-300 px-3.5 py-2 text-base text-navy dark:text-white outline-none focus:border-aqua-700 focus:ring-2 focus:ring-aqua-700/30"
            />
          </div>
        </div>
        <div>
          <label for="last-name" class="block font-semibold text-navy dark:text-slate-200 text-sm">Nachname</label>
          <div class="mt-2.5">
            <input
              type="text"
              name="last-name"
              id="last-name"
              autocomplete="family-name"
              required
              class="block w-full border border-navy-100 bg-white dark:bg-navy-400 dark:border-navy-300 px-3.5 py-2 text-base text-navy dark:text-white outline-none focus:border-aqua-700 focus:ring-2 focus:ring-aqua-700/30"
            />
          </div>
        </div>
        <div class="sm:col-span-2">
          <label for="company" class="block font-semibold text-navy dark:text-slate-200 text-sm">Firma</label>
          <div class="mt-2.5">
            <input
              type="text"
              name="company"
              id="company"
              autocomplete="organization"
              class="block w-full border border-navy-100 bg-white dark:bg-navy-400 dark:border-navy-300 px-3.5 py-2 text-base text-navy dark:text-white outline-none focus:border-aqua-700 focus:ring-2 focus:ring-aqua-700/30"
            />
          </div>
        </div>
        <div class="sm:col-span-2">
          <label for="email" class="block font-semibold text-navy dark:text-slate-200 text-sm">E-Mail</label>
          <div class="mt-2.5">
            <input
              type="email"
              name="email"
              id="email"
              autocomplete="email"
              required
              class="block w-full border border-navy-100 bg-white dark:bg-navy-400 dark:border-navy-300 px-3.5 py-2 text-base text-navy dark:text-white outline-none focus:border-aqua-700 focus:ring-2 focus:ring-aqua-700/30"
            />
          </div>
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="block font-semibold text-navy dark:text-slate-200 text-sm">Nachricht</label>
          <div class="mt-2.5">
            <textarea
              name="message"
              id="message"
              rows="4"
              required
              class="block w-full border border-navy-100 bg-white dark:bg-navy-400 dark:border-navy-300 px-3.5 py-2 text-base text-navy dark:text-white outline-none focus:border-aqua-700 focus:ring-2 focus:ring-aqua-700/30"
            ></textarea>
          </div>
        </div>
        <div class="flex gap-x-3 sm:col-span-2 items-start">
          <input
            type="checkbox"
            name="datenschutz"
            id="datenschutz"
            value="accepted"
            required
            class="mt-1 h-4 w-4 accent-aqua-700 border-navy-300"
          />
          <label for="datenschutz" class="text-sm text-muted">
            Ich habe die
            <a href="/datenschutz" class="font-semibold text-aqua-700 hover:text-aqua dark:text-aqua"
              >Datenschutzerklärung</a
            >
            gelesen und bin mit der Verarbeitung meiner Angaben zur Bearbeitung der Anfrage einverstanden.
            {/* ⟦rechtlich prüfen lassen⟧ */}
          </label>
        </div>
      </div>
      <div class="mt-10">
        <button type="submit" class="btn btn-primary w-full">Absenden</button>
      </div>
    </form>
  </div>
</Layout>
