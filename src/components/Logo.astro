---
import logoLight from '~/assets/brand/logos/kieks.me-horizontal-aqua-light.svg';
import logoDark from '~/assets/brand/logos/kieks.me-horizontal-aqua-dark.svg';
---

{/* Brand logo: aqua variant. ⟦BESTÄTIGEN: Standard-Logovariante aqua | purple | red⟧ */}
<span class="self-center ml-2 rtl:ml-0 rtl:mr-2 inline-flex items-center">
  <img
    src={logoLight.src}
    alt="kieks.me"
    width="140"
    height="32"
    class="h-7 w-auto min-w-[100px] dark:hidden"
    decoding="async"
  />
  <img
    src={logoDark.src}
    alt="kieks.me"
    width="140"
    height="32"
    class="h-7 w-auto min-w-[100px] hidden dark:inline"
    decoding="async"
  />
</span>
