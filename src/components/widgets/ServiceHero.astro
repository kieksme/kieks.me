---
import Button from '~/components/ui/atoms/Button.astro';
import Sticker from '~/components/ui/atoms/Sticker.astro';
import Heading from '~/components/ui/atoms/Heading.astro';
import Lead from '~/components/ui/atoms/Lead.astro';
import Halftone from '~/components/ui/atoms/Halftone.astro';
import ZigzagDivider from '~/components/ui/atoms/ZigzagDivider.astro';
import Burst from '~/components/ui/atoms/Burst.astro';
import { BOOKING_URL } from '~/config/site';

export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
  badge?: string;
  id?: string;
  /** Optional accent word shown in a starburst (e.g. „mcp“) */
  burstLabel?: string;
}

const {
  title,
  subtitle,
  ctaText = 'Erstgespräch buchen',
  ctaHref = BOOKING_URL,
  badge = 'Leistung',
  id,
  burstLabel,
} = Astro.props;
---

<section class="relative overflow-hidden not-prose" style="background: var(--hero-bg);" {...id ? { id } : {}}>
  <Halftone
    class="hidden md:block right-0 top-0"
    width={620}
    height={560}
    pitch={20}
    origin="top-right"
    d0={14.78}
    k={0.018}
    color="var(--hero-dots)"
    opacity={0.22}
  />
  <div class="relative mx-auto max-w-[1440px] px-5 md:px-20 py-16 md:py-24">
    <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
      <div class="flex flex-col gap-7 max-w-3xl">
        <Sticker color="yellow" shadow="fuchsia" rotate={3}>{badge}</Sticker>
        <Heading level={1} size="l" color="var(--hero-heading)" shadowColor="var(--pop-fuchsia)" shadowSize="6px 6px 0">
          {title}
        </Heading>
        <Lead size="l" class="!text-[color:var(--hero-text)]">
          {subtitle}
        </Lead>
        <div>
          <Button variant="primary" text={ctaText} href={ctaHref} icon="tabler:calendar-event" />
        </div>
      </div>
      {
        burstLabel && (
          <div class="relative justify-self-center w-full max-w-[360px] aspect-square">
            <Burst variant="mcp" class="w-full h-auto" width={360} height={360} />
            <p
              class="absolute inset-0 flex items-center justify-center font-heading font-black lowercase text-[clamp(2.5rem,8vw,4rem)] text-white motion-safe:pop-wobble"
              style="--pop-rotate: 8deg; transform: rotate(8deg); text-shadow: 6px 6px 0 var(--pop-aqua); -webkit-text-stroke: 3px var(--pop-navy); paint-order: stroke fill;"
            >
              {burstLabel}
            </p>
          </div>
        )
      }
    </div>
  </div>
  <ZigzagDivider top="var(--hero-bg)" bottom="var(--page-bg)" />
</section>
