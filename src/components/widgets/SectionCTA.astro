---
import Button from '~/components/ui/Button.astro';
import KantenDivider from '~/components/ui/KantenDivider.astro';
import { BOOKING_URL, CONTACT_EMAIL } from '~/config/site';

export interface Props {
  title: string;
  text?: string;
  ctaText?: string;
  ctaHref?: string;
  showEmailLink?: boolean;
}

const { title, text, ctaText = 'Erstgespräch buchen', ctaHref = BOOKING_URL, showEmailLink = false } = Astro.props;
---

<section class="relative not-prose overflow-hidden">
  <KantenDivider from="navy" flip class="bg-page text-navy" />
  <div class="absolute inset-0 top-8 bg-navy" aria-hidden="true"></div>
  <div class="kanten-hero-bg" aria-hidden="true">
    <span class="kanten-hero-bg__block kanten-hero-bg__block--aqua"></span>
    <span class="kanten-hero-bg__block kanten-hero-bg__block--fuchsia"></span>
  </div>
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 py-16 md:py-20 text-center">
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-white leading-tight">{title}</h2>
    {text && <p class="mt-4 text-lg text-white/85 max-w-2xl mx-auto">{text}</p>}
    <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <Button
        variant="primary"
        text={ctaText}
        href={ctaHref}
        icon="tabler:calendar-event"
        class="!bg-aqua !border-aqua !text-navy hover:!bg-aqua-600 hover:!border-aqua-600"
      />
      {
        showEmailLink && (
          <a class="text-aqua hover:text-white underline-offset-4 hover:underline" href={`mailto:${CONTACT_EMAIL}`}>
            Lieber per E-Mail: {CONTACT_EMAIL}
          </a>
        )
      }
    </div>
  </div>
</section>
