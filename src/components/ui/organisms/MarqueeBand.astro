---
import Sticker from '~/components/ui/atoms/Sticker.astro';

export interface Props {
  sticker?: string;
  text?: string;
  class?: string;
}

const {
  sticker = 'unsere haltung',
  text = 'einfach statt kompliziert  ·  bewährt statt modisch  ·  offen statt abhängig',
  class: className = '',
} = Astro.props;
const statements = text.split(/\s*·\s*/).filter(Boolean);
---

<section
  class:list={['pop-marquee-band overflow-hidden', className]}
  style="background: var(--band-bg); color: var(--band-text);"
>
  <div
    class="mx-auto max-w-[1440px] px-5 md:px-20 pt-7 pb-8 md:pt-[26px] md:pb-[30px] flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6"
  >
    <Sticker color="fuchsia" shadow="aqua" rotate={4} size="lg" class="shrink-0 z-10 relative max-md:!text-lg">
      {sticker}
    </Sticker>
    <p class="pop-band__message font-heading font-black text-[26px] leading-8 md:sr-only">
      {statements.map((statement) => <span class="block">{`${statement}${/[.!?]$/.test(statement) ? '' : '.'}`}</span>)}
    </p>
    <div class="hidden md:block overflow-hidden flex-1 min-w-0" aria-hidden="true">
      <div class="motion-safe:pop-marquee flex whitespace-nowrap w-max">
        <p class="font-heading font-black text-[clamp(1.25rem,2.5vw,2rem)] leading-none pr-16">
          {text}&nbsp;&nbsp;{text}
        </p>
        <p class="font-heading font-black text-[clamp(1.25rem,2.5vw,2rem)] leading-none pr-16">
          {text}&nbsp;&nbsp;{text}
        </p>
      </div>
    </div>
  </div>
</section>
