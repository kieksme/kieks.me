---
export interface Props {
  /** Sanitized HTML from the CMS (`services.descriptionRichText`); renders nothing when empty. */
  html?: string;
}
const { html } = Astro.props;
---

{
  html && (
    <section class="not-prose py-12 md:py-16" style="background: var(--page-bg);" aria-label="Details">
      <div class="mx-auto max-w-3xl px-5 md:px-20">
        <div class="cms-rich text-lg leading-8" style="color: var(--text-primary);" set:html={html} />
      </div>
    </section>
  )
}
