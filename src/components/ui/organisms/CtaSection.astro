---
import Heading from '~/components/ui/atoms/Heading.astro';
import Button from '~/components/ui/atoms/Button.astro';
import Halftone from '~/components/ui/atoms/Halftone.astro';
import Flames from '~/components/ui/atoms/Flames.astro';
import SpeechBubble from '~/components/ui/molecules/SpeechBubble.astro';
import Note from '~/components/ui/atoms/Note.astro';
import { BOOKING_URL, CONTACT_EMAIL, HAS_BOOKING_URL } from '~/config/site';

export interface Props {
  title: string;
  text?: string;
  ctaText?: string;
  ctaHref?: string;
  showEmailLink?: boolean;
  class?: string;
}

const {
  title,
  text,
  ctaText = 'Erstgespräch buchen',
  ctaHref = BOOKING_URL,
  showEmailLink = false,
  class: className = '',
} = Astro.props;
---

<section class:list={['pop-cta relative overflow-hidden not-prose', className]} style="background: var(--pop-fuchsia);">
  <Halftone
    width={390}
    height={300}
    pitch={16}
    origin="top"
    d0={9}
    k={0.03}
    color="var(--pop-purple)"
    opacity={0.5}
    class="md:hidden left-1/2 -translate-x-1/2 top-0"
  />
  <Halftone
    width={1440}
    height={420}
    pitch={24}
    origin="top"
    d0={11.66}
    k={0.0286}
    color="var(--pop-purple)"
    opacity={0.5}
    class="hidden md:block left-1/2 -translate-x-1/2 top-0"
  />
  <div
    class="relative mx-auto max-w-[1440px] px-5 md:px-20 pt-14 md:pt-[100px] pb-5 md:pb-[30px] text-left md:text-center"
  >
    <Heading
      level={2}
      size="cta"
      color="#fff"
      shadowColor="var(--pop-navy)"
      class="max-w-[252px] md:max-w-none md:mx-auto"
    >
      {title}
    </Heading>
    <SpeechBubble
      class="pop-cta__bubble mx-auto mt-6 md:mt-7 max-w-[820px] text-left md:text-center !px-5 !pt-5 !pb-[22px] md:!px-9 md:!py-7"
    >
      {
        text && (
          <p class="text-lg leading-7 md:text-[22px] md:leading-8" style="color: var(--text-primary);">
            {text}
          </p>
        )
      }
      <div
        class="mt-[18px] md:mt-[22px] flex flex-col md:flex-row gap-[18px] md:gap-7 md:justify-center items-start md:items-center"
      >
        <Button variant="primary" size="lg" href={ctaHref} text={ctaText} class="!text-lg md:!text-xl" />
        {
          showEmailLink && (
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="font-heading font-extrabold text-base md:text-lg"
              style="color: var(--text-link);"
            >
              Lieber per E-Mail: {CONTACT_EMAIL}
            </a>
          )
        }
      </div>
    </SpeechBubble>
    {
      !HAS_BOOKING_URL && (
        <Note label="⟦PLATZHALTER⟧" class="md:mx-auto mt-6 md:mt-7 max-w-[460px] text-left">
          Buchungslink fürs 30-Minuten-Erstgespräch (Tool noch offen).
        </Note>
      )
    }
  </div>
  <Flames />
</section>

<style>
  @media (max-width: 767px) {
    .pop-cta :global(.pop-cta__bubble) {
      box-shadow: 7px 7px 0 0 var(--pop-aqua) !important;
    }
  }
</style>
