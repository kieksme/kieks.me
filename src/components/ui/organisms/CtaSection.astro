---
import Heading from '~/components/ui/atoms/Heading.astro';
import Button from '~/components/ui/atoms/Button.astro';
import Halftone from '~/components/ui/atoms/Halftone.astro';
import Flames from '~/components/ui/atoms/Flames.astro';
import SpeechBubble from '~/components/ui/molecules/SpeechBubble.astro';
import Note from '~/components/ui/atoms/Note.astro';
import { BOOKING_URL, CONTACT_EMAIL, HAS_BOOKING_URL } from '~/config/site';

export interface Props {
  title: string;
  text?: string;
  ctaText?: string;
  ctaHref?: string;
  showEmailLink?: boolean;
  class?: string;
}

const {
  title,
  text,
  ctaText = 'Erstgespräch buchen',
  ctaHref = BOOKING_URL,
  showEmailLink = false,
  class: className = '',
} = Astro.props;
---

<section class:list={['relative overflow-hidden not-prose', className]} style="background: var(--pop-fuchsia);">
  <Halftone
    width={1440}
    height={420}
    pitch={24}
    origin="top"
    d0={11.66}
    k={0.0286}
    color="#9747ff"
    opacity={0.5}
    class="!relative w-full max-w-none left-0 top-0 opacity-50 md:absolute md:inset-x-0 md:top-0"
  />
  <div class="relative mx-auto max-w-[1440px] px-5 md:px-20 pt-10 md:pt-24 pb-8 text-center">
    <Heading level={2} size="cta" color="#fff" shadowColor="var(--pop-navy)" shadowSize="7px 7px 0" class="mx-auto">
      {title}
    </Heading>
    <SpeechBubble class="mx-auto mt-10 max-w-[820px] text-center">
      {
        text && (
          <p class="text-[22px] leading-8" style="color: var(--text-primary);">
            {text}
          </p>
        )
      }
      <div class="mt-5 flex flex-col sm:flex-row gap-7 justify-center items-center">
        <Button variant="primary" size="lg" href={ctaHref} text={ctaText} icon="tabler:calendar-event" />
        {
          showEmailLink && (
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="font-heading font-extrabold text-lg"
              style="color: var(--text-link);"
            >
              Lieber per E-Mail: {CONTACT_EMAIL}
            </a>
          )
        }
      </div>
    </SpeechBubble>
    {
      !HAS_BOOKING_URL && (
        <Note label="⟦PLATZHALTER⟧" class="mx-auto mt-6 max-w-[460px] text-left">
          Buchungslink fürs 30-Minuten-Erstgespräch (Tool noch offen).
        </Note>
      )
    }
  </div>
  <Flames class="mt-8" />
</section>
