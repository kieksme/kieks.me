---
import cardHalftone from '~/assets/pop/653-21_service-card__imgGroup.svg?url';
import TextLink from '~/components/ui/atoms/TextLink.astro';

export interface Props {
  num: string;
  title: string;
  description: string;
  href: string;
  linkText: string;
  headColor: 'aqua' | 'fuchsia' | 'purple' | 'navy';
  shadow?: 'ink' | 'fuchsia';
  numShadow?: 'fuchsia' | 'aqua';
  numColor?: string;
  class?: string;
}

const {
  num,
  title,
  description,
  href,
  linkText,
  headColor,
  shadow = 'ink',
  numShadow = 'fuchsia',
  numColor,
  class: className = '',
} = Astro.props;

const heads = {
  aqua: 'var(--pop-aqua)',
  fuchsia: 'var(--pop-fuchsia)',
  purple: 'var(--pop-purple)',
  navy: 'var(--pop-navy)',
};
const shadowColor = shadow === 'fuchsia' ? 'var(--pop-fuchsia)' : 'var(--ink)';
const nShadow = numShadow === 'aqua' ? 'var(--pop-aqua)' : 'var(--pop-fuchsia)';
const nColor = numColor ?? (headColor === 'purple' || headColor === 'navy' ? '#fff' : 'var(--pop-navy)');
---

<article
  class:list={['pop-service-card flex flex-col bg-[var(--surface)] border-[3px] border-[var(--ink)]', className]}
  style={`--pop-card-shadow-color: ${shadowColor};`}
  lang="de"
>
  <div
    class="relative h-[132px] overflow-hidden border-b-[3px] border-[var(--ink)] pl-6 pt-[18px] max-md:h-auto max-md:w-[84px] max-md:shrink-0 max-md:border-b-0 max-md:border-r-[3px] max-md:flex max-md:justify-center max-md:pl-0 max-md:pt-[14px] max-md:pb-4"
    style={`background: ${heads[headColor]};`}
  >
    <div
      class="absolute left-[120px] top-0 h-[132px] w-[300px] opacity-25 pointer-events-none max-md:hidden"
      aria-hidden="true"
    >
      <img src={cardHalftone} alt="" class="w-full h-full object-cover" width="300" height="132" />
    </div>
    <span
      class="pop-service-card__number relative font-heading font-black text-[80px] leading-[normal] max-md:text-[40px]"
      style={`color: ${nColor}; --pop-number-shadow-color: ${nShadow};`}
    >
      {num}
    </span>
  </div>
  <div
    class="pop-service-card__body flex flex-col gap-3 px-6 pt-[22px] pb-[26px] flex-1 max-md:gap-2 max-md:px-4 max-md:pt-4 max-md:pb-[18px]"
  >
    <h3 class="pop-service-card__title font-heading font-extrabold" style="color: var(--text-primary);">{title}</h3>
    <p class="text-lg leading-7" style="color: var(--text-secondary);">{description}</p>
    <TextLink href={href} class="pop-service-card__link max-md:!text-[15px]">{linkText}</TextLink>
  </div>
</article>

<style>
  .pop-service-card {
    box-shadow: 8px 8px 0 0 var(--pop-card-shadow-color);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .pop-service-card__title {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    line-height: 1.25;
    hyphens: auto;
    -webkit-hyphens: auto;
    overflow-wrap: break-word;
    word-break: normal;
  }
  .pop-service-card__link {
    margin-top: auto;
  }
  .pop-service-card__number {
    text-shadow: 4px 4px 0 var(--pop-number-shadow-color);
  }
  @media (min-width: 768px) {
    .pop-service-card:hover,
    .pop-service-card:focus-within {
      transform: translate(-4px, -4px) rotate(-0.4deg);
      box-shadow: 12px 12px 0 0 var(--pop-fuchsia);
    }
  }
  @media (max-width: 767px) {
    .pop-service-card {
      flex-direction: row;
      align-items: stretch;
      box-shadow: 6px 6px 0 0 var(--pop-card-shadow-color);
    }
    .pop-service-card:hover,
    .pop-service-card:focus-within {
      box-shadow: 8px 8px 0 0 var(--pop-fuchsia);
    }
    .pop-service-card__number {
      text-shadow: 3px 3px 0 var(--pop-number-shadow-color);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pop-service-card {
      transition: none;
    }
    .pop-service-card:hover,
    .pop-service-card:focus-within {
      transform: none;
    }
  }
</style>
