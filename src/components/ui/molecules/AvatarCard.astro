---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import vector1 from '~/assets/pop/654-1674_team__imgVector1.svg?url';

export interface Props {
  name: string;
  label: string;
  image: ImageMetadata;
  imageAlt: string;
  role?: string;
  class?: string;
}

const { name, label, image, imageAlt, role, class: className = '' } = Astro.props;
const display = label.toLocaleLowerCase('de-DE');
---

<figure class:list={['pop-avatar flex flex-col items-center gap-[18px] w-full max-w-[400px]', className]}>
  <div class="pop-avatar__box relative w-[min(100%,361px)] aspect-[361/499]">
    <img
      src={vector1}
      alt=""
      aria-hidden="true"
      class="pop-avatar-layer absolute w-[94%] h-auto left-0 top-[2%]"
      style="filter: brightness(0) saturate(100%) invert(90%);"
    />
    <img
      src={vector1}
      alt=""
      aria-hidden="true"
      class="pop-avatar-layer absolute w-[94%] h-auto left-[5%] top-[1%]"
      style="filter: brightness(0) saturate(100%) invert(22%) sepia(98%) saturate(5000%) hue-rotate(305deg);"
    />
    <img
      src={vector1}
      alt=""
      aria-hidden="true"
      class="pop-avatar-layer absolute w-[94%] h-auto left-[3%] top-[3%]"
      style="filter: brightness(0) saturate(100%) invert(88%) sepia(48%) saturate(2000%) hue-rotate(121deg);"
    />
    <div class="absolute left-[2%] top-0 w-[86%] h-[88%] overflow-hidden" style="clip-path: url(#avatar-clip);">
      <Picture
        class="w-full h-full object-cover object-top"
        src={image}
        alt={imageAlt}
        widths={[200, 311, 400]}
        sizes="311px"
        formats={['avif', 'webp']}
        loading="lazy"
        decoding="async"
      />
    </div>
    <figcaption
      class="absolute left-1/2 -translate-x-1/2 bottom-[8%] z-10 font-heading font-black lowercase text-[clamp(2.5rem,8vw,6rem)] leading-none tracking-[-0.05em] whitespace-nowrap"
      style="color: var(--pop-navy); -webkit-text-stroke: 10px var(--pop-aqua); paint-order: stroke fill;"
    >
      {display}
    </figcaption>
  </div>
  {
    role && (
      <p class="text-center text-sm max-w-[22rem]" style="color: var(--text-secondary);">
        {role}
      </p>
    )
  }
  <span class="sr-only">{name}</span>
</figure>

<style>
  .pop-avatar:hover .pop-avatar-layer:nth-child(1) {
    transform: translate(-6px, 4px);
  }
  .pop-avatar:hover .pop-avatar-layer:nth-child(2) {
    transform: translate(6px, -4px);
  }
  .pop-avatar:hover .pop-avatar-layer:nth-child(3) {
    transform: translate(-2px, 2px);
  }
  .pop-avatar-layer {
    transition: transform 0.25s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .pop-avatar:hover .pop-avatar-layer {
      transform: none;
    }
  }
</style>
