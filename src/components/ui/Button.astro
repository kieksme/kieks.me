---
/** Compatibility wrapper → atoms/Button */
import AtomButton from '~/components/ui/atoms/Button.astro';
import type { CallToAction as Props } from '~/types';

const props = Astro.props as Props & { class?: string };
const variant =
  props.variant === 'primary'
    ? 'primary'
    : props.variant === 'secondary'
      ? 'secondary'
      : props.variant === 'link'
        ? 'secondary'
        : 'primary';
---

<AtomButton
  variant={variant}
  href={props.href ? String(props.href) : undefined}
  text={typeof props.text === 'string' ? props.text : undefined}
  icon={props.icon}
  type={props.type === 'button' || props.type === 'submit' || props.type === 'reset' ? props.type : undefined}
  target={props.target ? String(props.target) : undefined}
  class={props.class}
>
  <slot />
</AtomButton>
