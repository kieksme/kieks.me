---
/** Compatibility entry: implementation is shared by kieks.me.ui. */
import Shared from '@kieksme/kieksme-astro/website/Button';
import type { Props as SharedProps } from '@kieksme/kieksme-astro/website/Button';
type Props = SharedProps;
import { Icon } from 'astro-icon/components';
const { icon = '', ...props } = Astro.props;
---

<Shared {...props}
  ><slot /><Fragment slot="icon">{icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-0.5 inline-block" />}</Fragment
  ></Shared
>
