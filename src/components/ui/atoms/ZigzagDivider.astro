---
/**
 * Tooth divider — SPEC §3.3
 * top = section above bg, bottom = teeth fill (section below)
 */
import zackenUrl from '~/assets/pop/652-914_divider-zacken__imgZacken.svg?url';

export interface Props {
  top?: string;
  bottom?: string;
  height?: 26 | 18;
  class?: string;
}

const { top = 'var(--hero-bg)', bottom = 'var(--band-bg)', height = 26, class: className = '' } = Astro.props;
---

<div
  class:list={['pop-zigzag relative w-full overflow-hidden leading-none', className]}
  style={`background: ${top}; height: ${height}px;`}
  aria-hidden="true"
>
  <div
    class="absolute inset-0 w-full h-full"
    style={`background-color: ${bottom}; -webkit-mask-image: url(${zackenUrl}); mask-image: url(${zackenUrl}); -webkit-mask-size: auto 100%; mask-size: auto 100%; -webkit-mask-repeat: repeat-x; mask-repeat: repeat-x;`}
  >
  </div>
</div>
