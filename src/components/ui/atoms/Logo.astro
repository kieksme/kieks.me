---
/**
 * Brand logo — horizontal wordmark keeps finger clear of the „k“.
 * Finger tip/wiggle is CSS-only (load + hover), disabled under prefers-reduced-motion.
 */
import circleLogo from '~/assets/brand/logos/kieks.me-single-circle.svg?url';
import circleLogoDark from '~/assets/brand/logos/kieks.me-single-circle-dark.svg?url';

export interface Props {
  variant?: 'auto' | 'light' | 'dark';
  size?: 'sm' | 'md' | 'hero';
  layout?: 'mark' | 'horizontal';
  isAnimated?: boolean;
  class?: string;
}

const { variant = 'auto', size = 'md', layout = 'mark', isAnimated = true, class: className = '' } = Astro.props;
const markSizes = {
  sm: { dimension: 44, class: 'h-11 w-11' },
  md: { dimension: 56, class: 'h-14 w-14' },
  hero: { dimension: 520, class: 'h-auto w-full max-w-[520px]' },
};
const wordmarkSizes = {
  /* Extra gap keeps the finger tip clear of the „k“, especially on mobile. */
  sm: { mark: 30, text: 'text-[1.35rem]', gap: 'gap-3' },
  md: { mark: 40, text: 'text-[1.75rem]', gap: 'gap-3.5' },
  hero: { mark: 72, text: 'text-[3rem]', gap: 'gap-4' },
};
const dimensions = markSizes[size];
const word = wordmarkSizes[size];
---

<span
  class:list={[
    'brand-logo inline-flex shrink-0 items-center',
    layout === 'horizontal' && ['brand-logo--horizontal', word.gap],
    { 'brand-logo--animated': isAnimated },
    className,
  ]}
  data-logo-variant={variant}
  data-logo-layout={layout}
>
  {
    layout === 'mark' ? (
      <>
        {(variant === 'auto' || variant === 'light') && (
          <img
            src={circleLogo}
            alt="kieks.me"
            width={dimensions.dimension}
            height={dimensions.dimension}
            class:list={[
              'brand-logo__mark aspect-square object-contain',
              dimensions.class,
              variant === 'auto' && 'dark:hidden',
            ]}
            decoding="async"
          />
        )}
        {(variant === 'auto' || variant === 'dark') && (
          <img
            src={circleLogoDark}
            alt={variant === 'dark' ? 'kieks.me' : ''}
            aria-hidden={variant === 'auto' ? 'true' : undefined}
            width={dimensions.dimension}
            height={dimensions.dimension}
            class:list={[
              'brand-logo__mark aspect-square object-contain',
              dimensions.class,
              variant === 'auto' && 'hidden dark:block',
            ]}
            decoding="async"
          />
        )}
      </>
    ) : (
      <>
        {/* Solid navy disc (no aqua ring) so the header stays clean in dark mode; finger never overlaps „k“. */}
        <span class="brand-logo__finger relative inline-flex shrink-0" aria-hidden="true">
          <img
            src={circleLogo}
            alt=""
            width={word.mark}
            height={word.mark}
            class="brand-logo__mark h-auto w-auto object-contain"
            style={`width:${word.mark}px;height:${word.mark}px;`}
            decoding="async"
          />
        </span>
        <span
          class:list={['brand-logo__word font-heading font-black lowercase leading-none tracking-[-0.04em]', word.text]}
          style="color: var(--text-primary);"
        >
          kieks<span style="color: var(--pop-fuchsia);">.me</span>
        </span>
      </>
    )
  }
</span>

<style>
  .brand-logo--animated .brand-logo__mark {
    transform-origin: 70% 55%;
    animation: brand-finger-tip 1.1s cubic-bezier(0.3, 1.4, 0.5, 1) both;
  }
  .brand-logo--animated:hover .brand-logo__mark,
  .brand-logo--animated:focus-within .brand-logo__mark {
    animation: brand-finger-wiggle 0.55s ease-in-out;
  }
  /* Horizontal wordmark: rotate only so the fingertip never slides into the „k“. */
  .brand-logo--horizontal.brand-logo--animated .brand-logo__mark {
    transform-origin: 55% 55%;
    animation: brand-finger-tip-safe 1.1s cubic-bezier(0.3, 1.4, 0.5, 1) both;
  }
  .brand-logo--horizontal.brand-logo--animated:hover .brand-logo__mark,
  .brand-logo--horizontal.brand-logo--animated:focus-within .brand-logo__mark {
    animation: brand-finger-wiggle-safe 0.55s ease-in-out;
  }
  @keyframes brand-finger-tip {
    0% {
      transform: translateX(-4px) rotate(-6deg);
      opacity: 0.6;
    }
    55% {
      transform: translateX(3px) rotate(4deg);
    }
    100% {
      transform: translateX(0) rotate(0deg);
      opacity: 1;
    }
  }
  @keyframes brand-finger-wiggle {
    0%,
    100% {
      transform: translateX(0) rotate(0deg);
    }
    35% {
      transform: translateX(3px) rotate(5deg);
    }
    70% {
      transform: translateX(-2px) rotate(-3deg);
    }
  }
  @keyframes brand-finger-tip-safe {
    0% {
      transform: rotate(-8deg);
      opacity: 0.7;
    }
    55% {
      transform: rotate(5deg);
    }
    100% {
      transform: rotate(0deg);
      opacity: 1;
    }
  }
  @keyframes brand-finger-wiggle-safe {
    0%,
    100% {
      transform: rotate(0deg);
    }
    35% {
      transform: rotate(6deg);
    }
    70% {
      transform: rotate(-4deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-logo--animated .brand-logo__mark,
    .brand-logo--animated:hover .brand-logo__mark,
    .brand-logo--animated:focus-within .brand-logo__mark {
      animation: none;
    }
  }
</style>
