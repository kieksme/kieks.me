---
/** FAQ diamond (−45°) or repo color square (−12°) */
export interface Props {
  variant?: 'diamond' | 'blob';
  color?: 'aqua' | 'fuchsia' | 'yellow' | 'purple';
  class?: string;
}

const { variant = 'diamond', color = 'aqua', class: className = '' } = Astro.props;
const colors = {
  aqua: 'var(--pop-aqua)',
  fuchsia: 'var(--pop-fuchsia)',
  yellow: 'var(--pop-yellow)',
  purple: 'var(--pop-purple)',
};
---

{
  variant === 'diamond' ? (
    <span
      class:list={['pop-faq-marker inline-block shrink-0 border-[3px] border-[var(--ink)]', className]}
      style={`width: 18px; height: 18px; background: ${colors[color]}; transform: rotate(-45deg); transition: transform 0.25s ease;`}
      aria-hidden="true"
    />
  ) : (
    <span
      class:list={['inline-block shrink-0 border-[3px] border-[var(--ink)]', className]}
      style={`width: 28px; height: 28px; background: ${colors[color]}; transform: rotate(-12deg); transition: transform 0.25s ease;`}
      aria-hidden="true"
    />
  )
}
