---
import Heading from '~/components/ui/atoms/Heading.astro';
import Lead from '~/components/ui/atoms/Lead.astro';
import FaqItem from '~/components/ui/molecules/FaqItem.astro';
import { renderMarkdown } from './safe-markdown';
import { plainText, renderRichText, safeMedia, safeHref } from './rich-text';
export interface Props {
  collection: string;
  document: Record<string, unknown>;
}
const { collection, document: data } = Astro.props;
const title = plainText(data.title ?? data.name ?? data.question) || 'Noch ohne Überschrift';
const image = safeMedia(data.heroImage ?? data.image ?? data.photo ?? data.avatar);
const richBody = renderRichText(
  data.contentRichText ?? data.descriptionRichText ?? data.bioRichText ?? data.answerRichText
);
const body = richBody || (collection === 'pages' ? renderMarkdown(data.contentMarkdown) : '');
const excerpt = plainText(collection === 'posts' ? data.excerpt : data.summary);
const publishedDate =
  collection === 'posts' && typeof data.publishedAt === 'string' && Number.isFinite(Date.parse(data.publishedAt))
    ? new Date(data.publishedAt)
    : null;
const authorRecord =
  collection === 'posts' && data.author && typeof data.author === 'object' && !Array.isArray(data.author)
    ? (data.author as Record<string, unknown>)
    : null;
const author = collection === 'posts' ? plainText(authorRecord?.name) || plainText(data.authorName) : '';
const previewHref = (collectionName: string, id: unknown) =>
  ['string', 'number'].includes(typeof id) && /^[a-zA-Z0-9_-]{1,100}$/.test(String(id))
    ? `/preview/${collectionName}/${encodeURIComponent(String(id))}`
    : null;
const authorHref = authorRecord ? previewHref('authors', authorRecord.id) : null;
const authorPosts =
  collection === 'authors' && Array.isArray(data.posts)
    ? (data.posts
        .filter((item) => item && typeof item === 'object' && typeof item.title === 'string')
        .slice(0, 100) as Record<string, unknown>[])
    : [];
const tags =
  collection === 'posts' && Array.isArray(data.tags)
    ? [
        ...new Set(
          data.tags
            .filter((item) => item && typeof item === 'object' && typeof item.tag === 'string')
            .map((item) => String(item.tag).trim())
            .filter(Boolean)
        ),
      ].slice(0, 30)
    : [];
const fallback = plainText(data.description ?? data.bio ?? data.answer);
const sections =
  collection === 'pages' && Array.isArray(data.sections)
    ? (data.sections.filter((item) => item && typeof item === 'object' && !Array.isArray(item)).slice(0, 100) as Record<
        string,
        unknown
      >[])
    : [];
const links =
  collection === 'navigation' && Array.isArray(data.links)
    ? (data.links.filter((item) => item && typeof item === 'object' && !Array.isArray(item)).slice(0, 100) as Record<
        string,
        unknown
      >[])
    : [];
---

<article class="editorial-content" data-editorial-collection={collection}>
  <div class="editorial-content__eyebrow">
    {
      collection === 'team'
        ? plainText(data.position)
        : collection === 'faqs' || collection === 'posts'
          ? plainText(data.category)
          : plainText(data.kind)
    }
  </div>
  <Heading level={1} size="xl">{title}</Heading>
  {
    collection === 'posts' && (
      <div class="editorial-content__meta">
        {publishedDate && (
          <time datetime={publishedDate.toISOString()}>
            {new Intl.DateTimeFormat('de-DE', { dateStyle: 'long', timeZone: 'UTC' }).format(publishedDate)}
          </time>
        )}
        {author && <span>Von {authorHref ? <a href={authorHref}>{author}</a> : author}</span>}
      </div>
    )
  }
  {excerpt && <Lead class="mt-8 max-w-3xl">{excerpt}</Lead>}
  {
    tags.length > 0 && (
      <ul class="editorial-content__tags" aria-label="Schlagwörter">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
  {
    image && (
      <figure class="editorial-content__hero">
        <img src={image.url} alt={image.alt} width={image.width} height={image.height} loading="eager" />
      </figure>
    )
  }
  {
    collection === 'faqs' ? (
      <div class="mt-10">
        <FaqItem title={title} open>
          <div class="editorial-prose">{body ? <Fragment set:html={body} /> : <p>{fallback}</p>}</div>
        </FaqItem>
      </div>
    ) : (
      <div class="editorial-prose mt-10">{body ? <Fragment set:html={body} /> : fallback && <p>{fallback}</p>}</div>
    )
  }
  {
    collection === 'authors' && (
      <section class="editorial-content__section" aria-label="Artikel dieser Person">
        <Heading level={2} size="l">
          Artikel
        </Heading>
        {authorPosts.length > 0 ? (
          <ul class="editorial-content__articles">
            {authorPosts.map((post) => (
              <li>
                <h3>
                  {previewHref('posts', post.id) ? (
                    <a href={previewHref('posts', post.id)!}>{plainText(post.title)}</a>
                  ) : (
                    plainText(post.title)
                  )}
                </h3>
                {plainText(post.excerpt) && <p>{plainText(post.excerpt)}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="editorial-prose mt-6">Noch keine veröffentlichten Artikel zugeordnet.</p>
        )}
      </section>
    )
  }
  {
    collection === 'authors' && data.contactEnabled === true && (
      <section class="editorial-content__section" aria-label="Kontaktformular-Vorschau">
        <Heading level={2} size="l">
          Kontakt aufnehmen
        </Heading>
        <p class="editorial-prose mt-6">Vorschau – Nachrichten können hier nicht gesendet werden.</p>
        <form class="editorial-content__contact" aria-label="Inaktive Kontaktformular-Vorschau">
          <fieldset disabled>
            <legend>Kontakt an {title}</legend>
            <label>
              Name
              <input name="name" type="text" autocomplete="off" />
            </label>
            <label>
              E-Mail
              <input name="email" type="email" autocomplete="off" />
            </label>
            <label>
              Nachricht
              <textarea name="message" rows={5} />
            </label>
            <button type="button" disabled>
              Vorschau – kein Versand
            </button>
          </fieldset>
        </form>
      </section>
    )
  }
  {
    sections.map((section) => {
      const sectionImage = safeMedia(section.media);
      const rich = renderRichText(section.richText);
      return (
        <section class="editorial-content__section">
          {plainText(section.heading) && (
            <Heading level={2} size="l">
              {plainText(section.heading)}
            </Heading>
          )}
          <div class="editorial-prose mt-6">
            {rich ? <Fragment set:html={rich} /> : <p>{plainText(section.body)}</p>}
          </div>
          {sectionImage && (
            <figure>
              <img
                src={sectionImage.url}
                alt={sectionImage.alt}
                width={sectionImage.width}
                height={sectionImage.height}
                loading="lazy"
              />
            </figure>
          )}
        </section>
      );
    })
  }
  {
    collection === 'mcp-projects' && (
      <nav aria-label="Projektlinks" class="editorial-content__links">
        {[
          ['Repository', data.repositoryUrl],
          ['Dokumentation', data.documentationUrl],
        ].map(
          ([label, href]) =>
            safeHref(href) && (
              <a href={safeHref(href)!} rel="noopener noreferrer">
                {label} ↗
              </a>
            )
        )}
        {plainText(data.license) && <span>Lizenz: {plainText(data.license)}</span>}
      </nav>
    )
  }
  {
    links.length > 0 && (
      <nav aria-label={title} class="editorial-content__links">
        {links.map((link) => safeHref(link.href) && <a href={safeHref(link.href)!}>{plainText(link.label)}</a>)}
      </nav>
    )
  }
</article>
<style is:global>
  .editorial-content {
    max-width: 1180px;
    margin-inline: auto;
    padding: 64px 32px 100px;
  }
  .editorial-content__eyebrow {
    font: 700 16px/1.5 var(--aw-font-sans);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 24px;
    color: var(--text-secondary);
  }
  .editorial-content__hero {
    margin: 48px 0;
    max-width: 900px;
  }
  .editorial-content figure img {
    display: block;
    max-width: 100%;
    height: auto;
    border: 3px solid var(--pop-ink);
    box-shadow: 8px 8px 0 var(--pop-aqua);
  }
  .editorial-content__section {
    padding-top: 72px;
  }
  .editorial-prose {
    max-width: 780px;
    font: 400 22px/1.6 var(--aw-font-sans);
    overflow-wrap: anywhere;
  }
  .editorial-prose p,
  .editorial-prose ul,
  .editorial-prose ol,
  .editorial-prose blockquote,
  .editorial-prose figure {
    margin: 0 0 1.2em;
  }
  .editorial-prose h2,
  .editorial-prose h3,
  .editorial-prose h4 {
    font-family: var(--aw-font-heading);
    font-weight: 800;
    line-height: 1.15;
    margin: 1.5em 0 0.6em;
  }
  .editorial-prose h2 {
    font-size: 40px;
  }
  .editorial-prose h3 {
    font-size: 30px;
  }
  .editorial-prose ul {
    list-style: disc;
    padding-left: 1.4em;
  }
  .editorial-prose ol {
    list-style: decimal;
    padding-left: 1.4em;
  }
  .editorial-prose blockquote {
    border-left: 8px solid var(--pop-fuchsia);
    padding-left: 24px;
    font-style: italic;
  }
  .editorial-prose a,
  .editorial-content__links a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    color: var(--text-link);
  }
  .editorial-prose code {
    background: var(--pop-aqua);
    color: var(--pop-ink);
    padding: 0.1em 0.25em;
  }
  .editorial-content__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 28px;
    color: var(--text-secondary);
    font-size: 18px;
  }
  .editorial-content__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
    list-style: none;
    padding: 0;
  }
  .editorial-content__tags li {
    border: 2px solid var(--pop-ink);
    background: var(--pop-aqua);
    color: var(--pop-ink);
    font-size: 14px;
    font-weight: 700;
    padding: 4px 10px;
  }
  .editorial-prose pre {
    overflow: auto;
    white-space: pre-wrap;
    border: 2px solid var(--pop-ink);
    padding: 16px;
    margin-bottom: 24px;
  }
  .editorial-content[data-editorial-collection='authors'] .editorial-content__hero {
    max-width: 360px;
  }
  .editorial-content__articles {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 24px;
    margin-top: 32px;
  }
  .editorial-content__articles li {
    border: 3px solid var(--pop-ink);
    box-shadow: 6px 6px 0 var(--pop-aqua);
    padding: 24px;
    max-width: 780px;
  }
  .editorial-content__articles h3 {
    font: 800 28px/1.2 var(--aw-font-heading);
  }
  .editorial-content__articles p {
    margin-top: 12px;
    font-size: 18px;
    line-height: 28px;
  }
  .editorial-content__articles a,
  .editorial-content__meta a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .editorial-content__contact {
    max-width: 780px;
    margin-top: 32px;
  }
  .editorial-content__contact fieldset {
    border: 3px solid var(--pop-ink);
    padding: 24px;
  }
  .editorial-content__contact legend {
    font-weight: 800;
    padding-inline: 8px;
  }
  .editorial-content__contact label {
    display: grid;
    gap: 8px;
    margin-bottom: 20px;
    font-weight: 700;
  }
  .editorial-content__contact input,
  .editorial-content__contact textarea {
    width: 100%;
    border: 2px solid var(--pop-ink);
    background: var(--surface);
    padding: 12px;
    font: inherit;
    color: var(--text-primary);
  }
  .editorial-content__contact button {
    border: 2px solid var(--pop-ink);
    background: var(--pop-yellow);
    color: var(--pop-ink);
    padding: 12px;
    font-weight: 800;
    cursor: not-allowed;
  }
  .editorial-content__links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 48px;
    font-weight: 700;
  }
  @media (max-width: 767px) {
    .editorial-content {
      padding: 40px 20px 64px;
    }
    .editorial-prose {
      font-size: 18px;
      line-height: 28px;
    }
    .editorial-content__section {
      padding-top: 48px;
    }
    .editorial-prose h2 {
      font-size: 32px;
    }
  }
</style>
