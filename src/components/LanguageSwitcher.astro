---
import { alternatesForPath } from '~/utils/localization';
const alternates = await alternatesForPath(Astro.url.pathname);
const english = Astro.url.pathname.startsWith('/en');

// Kürzel für die Anzeige, volle Namen für Screenreader (aria-label / title)
const locales = [
  { code: 'de', short: 'DE', full: 'Deutsch' },
  { code: 'en', short: 'EN', full: 'English' },
] as const;

// Gemeinsame Basis: gleiche Höhe wie der Theme-Toggle (p-2 + 20px Icon + 3px Rahmen)
const base =
  'inline-flex items-center justify-center px-2.5 min-h-[36px] font-heading font-black text-sm tracking-wide';
---

<nav
  aria-label={english ? 'Language' : 'Sprache'}
  class="inline-flex items-stretch border-[3px] border-[var(--ink)] bg-[var(--surface)] shadow-[4px_4px_0_0_var(--pop-fuchsia)]"
>
  {
    locales.map(({ code, short, full }, i) => {
      const link = alternates.find((alternate) => alternate.locale === code);
      const active = code === (english ? 'en' : 'de');
      // Trennlinie zwischen den Segmenten
      const divider = i > 0 ? 'border-l-[3px] border-[var(--ink)]' : '';

      return active ? (
        <span
          lang={code}
          aria-current="page"
          aria-label={full}
          title={full}
          class:list={[base, divider, 'bg-[var(--pop-aqua)] text-[var(--pop-navy)]']}
        >
          {short}
        </span>
      ) : link ? (
        <a
          lang={code}
          hreflang={code}
          href={link.path}
          aria-label={full}
          title={full}
          class:list={[
            base,
            divider,
            'text-[var(--text-primary)] hover:bg-[var(--page-bg)] focus-visible:outline focus-visible:outline-[3px] focus-visible:-outline-offset-[3px] focus-visible:outline-[var(--pop-fuchsia)]',
          ]}
        >
          {short}
        </a>
      ) : (
        <span
          lang={code}
          aria-disabled="true"
          aria-label={full}
          title={english ? 'Translation not published' : 'Übersetzung nicht veröffentlicht'}
          class:list={[
            base,
            divider,
            'cursor-not-allowed text-[color-mix(in_srgb,var(--text-primary)_40%,transparent)]',
          ]}
        >
          {short}
        </span>
      );
    })
  }
</nav>
