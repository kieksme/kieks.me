---
/**
 * Visible marker for open content decisions.
 * Keep ⟦PLATZHALTER⟧ / ⟦BESTÄTIGEN⟧ / ⟦ENTSCHEIDUNG⟧ text in the page copy.
 */
export interface Props {
  label?: string;
  class?: string;
}

const { label = 'Offener Punkt', class: className = '' } = Astro.props;
---

<aside class:list={['pop-note my-4 text-sm', className]} data-placeholder="true" role="note">
  <p class="font-heading font-extrabold lowercase tracking-wide">{label}</p>
  <div class="mt-1 font-mono text-[0.9em] leading-relaxed">
    <slot />
  </div>
</aside>
